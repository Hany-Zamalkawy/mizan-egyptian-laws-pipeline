# ─── Egyptian Legal Data Pipeline Configuration ──────────────────────────────
# Copy this file to .env and fill in your actual values.
# IMPORTANT: .env is ignored by Git to protect secrets.

# ─── Google Drive API (Service Account) ───────────────────────────────────────
# Path to the downloaded service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Target Google Drive folder IDs (obtained from your browser address bar)
# Format: https://drive.google.com/drive/folders/<FOLDER_ID>
GDRIVE_RAW_FOLDER_ID=your_raw_folder_id_here
GDRIVE_PROCESSED_FOLDER_ID=your_processed_folder_id_here

# ─── Alerting & Notifications (Optional) ──────────────────────────────────────
# Telegram Bot Token (from @BotFather) and your chat ID (from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=

# ─── Pipeline Parameters ──────────────────────────────────────────────────────
SCRAPE_LIMIT_PER_CATEGORY=5
SCRAPE_MAX_PAGES=2
ENABLE_OCR_FALLBACK=True
OCR_LANGUAGE=ara
MIN_LAW_WORD_COUNT=25
