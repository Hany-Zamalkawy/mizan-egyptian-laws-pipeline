# ─── Local Pipeline & Google Drive Configuration ──────────────────────────────
# Copy this file to .env and adjust your folder IDs and paths.

# Google Service Account JSON Key path (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Drive Target Folder IDs (Get these from the folder URL in your browser)
# Example: https://drive.google.com/drive/folders/1a2B3c4D5e6F7g8H9i0J
GDRIVE_RAW_FOLDER_ID=your_raw_folder_id_here
GDRIVE_PROCESSED_FOLDER_ID=your_processed_folder_id_here

# Pipeline Settings
SCRAPE_LIMIT_PER_CATEGORY=5
SCRAPE_MAX_PAGES=1
